---
import type { LandingCopy } from '@/i18n/ui';
import Reveal from './Reveal.astro';

interface Props {
  t: LandingCopy;
}

const { t } = Astro.props;
---

<section class="section-pad bg-mb-bg-alt">
  <div class="wrap">
    <Reveal>
      <h2 class="h2 text-center">{t.stepsTitle}</h2>
    </Reveal>
    <ol class="mx-auto mt-14 max-w-narrow legacy-space-y-10">
      {
        t.steps.map((step, i) => (
          <Reveal delay={i * 70}>
            <li class="flex gap-6">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-mb-line text-sm font-semibold text-mb-fg2"
              >
                {i + 1}
              </span>
              <div>
                <h3 class="text-xl font-semibold">{step.title}</h3>
                <p class="mt-2 text-mb-fg2">{step.body}</p>
              </div>
            </li>
          </Reveal>
        ))
      }
    </ol>
  </div>
</section>
